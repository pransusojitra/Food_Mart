{
  "version": 2,
  "buildCommand": "npm install",
  "env": {
    "MONGO_URI": "@MONGO_URI",
    "NODE_ENV": "production"
  },
  "functions": {
    "server.js": {
      "memory": 512,
      "maxDuration": 30,
      "environment": [
        "MONGO_URI",
        "NODE_ENV"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    }
  ]
}
